# Caddy config for the SolbaTechs website (/etc/caddy/Caddyfile).
# Caddy obtains and renews HTTPS certificates for the domains automatically.
{
	email sales@solbatechs.com
}

solbatechs.com {
	root * /var/www/solbatechs
	file_server
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@static path /css/* /js/* /assets/*
	header @static Cache-Control "public, max-age=86400"

	handle_errors {
		redir * / 302
	}
}

# www and the bare server IP both send visitors to the main domain.
www.solbatechs.com {
	redir https://solbatechs.com{uri} permanent
}

http://46.225.76.29 {
	redir https://solbatechs.com{uri} permanent
}
